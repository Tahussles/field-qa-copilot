{
  "name": "field-qa-copilot",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n web,api -c blue,green \"pnpm:dev:web\" \"pnpm:dev:api\"",
    "dev:web": "node scripts/vendor-maplibre.mjs && next dev",
    "dev:api": "uv run uvicorn api.index:app --reload --reload-dir api --reload-dir engine --port 8000",
    "build": "node scripts/vendor-maplibre.mjs && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test:smoke": "playwright test"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "maplibre-gl": "^6.16.0",
    "next": "16.4.3",
    "qrcode": "^1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "concurrently": "^10.0.6",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "packageManager": "pnpm@12.6.0"
}
